{
  "openapi": "3.1.0",
  "info": {
    "title": "ProfCheck API",
    "description": "API REST pour interagir avec ProfCheck — pointage, enseignants, étudiants, planification et CRM.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://profcheck.vercel.app",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/mcp/teachers": {
      "get": {
        "summary": "Liste des enseignants",
        "operationId": "listTeachers",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des enseignants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Teacher" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/centers": {
      "get": {
        "summary": "Liste des centres",
        "operationId": "listCenters",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des centres",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Center" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/sessions/active": {
      "get": {
        "summary": "Sessions de pointage actives",
        "operationId": "getActiveSessions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Sessions actives avec enseignant, salle et centre",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AttendanceSession" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/students": {
      "get": {
        "summary": "Liste des étudiants",
        "operationId": "listStudents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des étudiants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Student" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/leads": {
      "get": {
        "summary": "Liste des prospects CRM",
        "operationId": "listLeads",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filtrer par statut (new, contacted, qualified, lost, won)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des prospects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CrmLead" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/planned-sessions": {
      "get": {
        "summary": "Sessions planifiées",
        "operationId": "listPlannedSessions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions planifiées",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PlannedSession" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/rooms": {
      "get": {
        "summary": "Liste des salles",
        "operationId": "listRooms",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des salles avec leur centre",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Room" }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/settings": {
      "get": {
        "summary": "Paramètres globaux",
        "operationId": "getSettings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Paramètres de l'application",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppSettings" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Teacher": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "full_name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "languages": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Center": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "allowed_radius_meters": { "type": "number" },
          "gps_verification_enabled": { "type": "boolean" }
        }
      },
      "AttendanceSession": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "teacher_id": { "type": "string" },
          "room_id": { "type": "string" },
          "center_id": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "status": { "type": "string" },
          "teacher": { "type": "object", "properties": { "full_name": { "type": "string" } } }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "full_name": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string" },
          "status": { "type": "string" },
          "access_status": { "type": "string" },
          "center_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CrmLead": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "parent_name": { "type": "string" },
          "student_name": { "type": "string" },
          "phone": { "type": "string" },
          "status": { "type": "string" },
          "source": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "PlannedSession": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "teacher_id": { "type": "string" },
          "room_id": { "type": "string" },
          "scheduled_date": { "type": "string", "format": "date" },
          "start_time": { "type": "string" },
          "end_time": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "center_id": { "type": "string" },
          "center": { "type": "object", "properties": { "name": { "type": "string" } } }
        }
      },
      "AppSettings": {
        "type": "object",
        "properties": {
          "auto_close_active_sessions": { "type": "boolean" },
          "auto_close_after_minutes": { "type": "integer" }
        }
      }
    }
  }
}
